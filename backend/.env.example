# Server Port (Default: 5000)
PORT=5000

# OpenAI API Key (Optional: If empty, uses the built-in deterministic Automotive Triage Engine)
OPENAI_API_KEY=

# OpenAI Model: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Service Center Branding
SERVICE_CENTER_NAME="Precision Auto Care & Service Center"
SERVICE_PHONE="(800) 555-AUTO"

# Max Conversation Turns to Retain
MAX_HISTORY_LENGTH=20

# PostgreSQL Database Configuration
# Option 1: Full connection URI
# DATABASE_URL=postgresql://postgres:password@localhost:5432/carservice

# Option 2: Individual connection fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=carservice
DB_SSL=false
